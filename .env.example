# ============================================================================
# RAJ HANS EVENTS - PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Zero hardcoding: All secrets, database URLs, and storage keys are managed here.
# ============================================================================

# 1. Database Configuration (Neon Serverless PostgreSQL)
# Get from Neon Console: https://console.neon.tech -> Connection Details
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Administrator Authentication & Session Security
# Generate a random 32+ character key (e.g. `openssl rand -base64 32`)
AUTH_SECRET=your-random-32-character-session-secret-key-min-length-32

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI:
#   Local: http://localhost:3000/api/auth/google/callback
#   Production: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional override for redirect URI (if different from origin):
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Places API (Direct Google Reviews & Ratings Import)
# Enable Places API in Google Cloud Console -> Create API Key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Optional: Place ID for Raj Hansh Events (auto-discovered if omitted)
GOOGLE_PLACE_ID=your-google-place-id

# Administrator Whitelist (Only these email addresses will be granted access to /Manage)
# Can be a single email or comma-separated list
ADMIN_EMAIL=your-client-admin@gmail.com
# ADMIN_EMAILS=admin1@gmail.com,admin2@rajhansevents.com
ADMIN_PASSWORD=your-secure-admin-password

# Base Application URL (Used for generating absolute OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Cloudflare R2 Media Storage (S3 Compatible)
# Get from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-api-secret-access-key
R2_BUCKET_NAME=rajhansevents-media

# Public CDN URL for serving images and videos
# Either Cloudflare's public r2.dev URL (e.g. https://pub-xyz.r2.dev) or custom domain (e.g. https://media.rajhansevents.com)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# 4. Meta / WhatsApp Cloud API Webhook & Messaging
WA_VERIFY_TOKEN=your-meta-webhook-verify-token
WA_PHONE_NUMBER_ID=your-whatsapp-business-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-cloud-api-permanent-access-token
WA_APP_SECRET=your-meta-app-secret-for-webhook-signature-verification

# 5. Resend Email API (https://resend.com)
# Get your API key from Resend Console: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdef
# Default onboarding sender or your verified custom domain email:
RESEND_FROM_EMAIL=Raj Hansh Events <onboarding@resend.dev>
# Target administrator inbox for new client enquiry notifications:
ADMIN_NOTIFICATION_EMAIL=rajhanshevent@gmail.com

# 6. Build Tools & Optional Diagnostics
ANALYZE=false

